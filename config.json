{
  "description": "Configuration for Multilayer Perceptron training on Wisconsin breast cancer dataset",
  
  "network": {
    "layer_sizes": [30, 16, 16, 2],
    "activation": "relu",
    "initialization": "xavier"
  },
  
  "training": {
    "epochs": 100,
    "batch_size": 32,
    "learning_rate": 0.01,
    "validation_split": 0.2,
    "shuffle": true
  },
  
  "data": {
    "dataset": "breast_cancer",
    "normalize": false,
    "standardize": true,
    "data_dir": "../data"
  },
  
  "output": {
    "model_path": "../models/trained_model.npy",
    "history_path": "../models/training_history.npy",
    "plots_dir": "../models/plots"
  }
}
